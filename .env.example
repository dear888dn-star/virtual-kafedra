# Nusxa oling: .env  (bu fayl git'ga tushmaydi). Kalitlarni faqat shu yerga yozing.
# 1-bosqichda kalit shart emas: tizim mock rejimida ishlaydi.

PORT=3100
# MOCK=1 majburan mock rejimini yoqadi
MOCK=1
# Mock tezligi: 1 = oddiy, 0.3 = tezroq, 0 = kutishsiz
MOCK_SPEED=1

# Provayder kalitlari (2-bosqichdan keyin ishlatiladi)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
